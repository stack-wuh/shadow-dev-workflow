{
  "description": "Shadow Dev Workflow — Codex 宿主生命周期钩子。SessionStart 自举锁版本 shadow-dev CLI：成功静默、失败仅告警、恒不阻塞会话。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/bootstrap-cli.sh\"",
            "commandWindows": "$p = if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } else { $env:CLAUDE_PLUGIN_ROOT }; $b = \"${env:ProgramFiles}\\Git\\bin\\bash.exe\"; if (-not (Test-Path -LiteralPath $b)) { $b = 'bash' }; if ($p -and (Get-Command $b -ErrorAction SilentlyContinue)) { & $b (($p -replace '\\\\','/') + '/hooks/bootstrap-cli.sh') }",
            "timeout": 60,
            "statusMessage": "shadow-dev CLI 自举"
          }
        ]
      }
    ]
  }
}