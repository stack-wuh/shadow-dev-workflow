#!/usr/bin/env bash
# Resolve and ensure the working-tree directory shadow-dev-tdd uses for its
# short-lived artifacts: task briefs, implementer reports, review packages,
# the wave table, and the progress ledger. Print the directory's absolute
# path.
#
# The workspace lives in the working tree (not under .git/) because agent
# hosts treat .git/ as a protected path and deny writes there — which would
# block an implementer subagent from writing its report file. A self-ignoring
# .gitignore keeps the workspace out of `git status` and out of accidental
# commits without modifying any tracked file; the repo's own .gitignore may
# additionally carry `.tdd/`.
#
# Single source of truth for the workspace location, so task-brief,
# review-package, and task-worktree cannot drift to different directories.
#
# Usage: tdd-workspace
set -euo pipefail

root=$(git rev-parse --show-toplevel)
dir="$root/.tdd"
mkdir -p "$dir"
printf '*\n' > "$dir/.gitignore"
cd "$dir" && pwd
